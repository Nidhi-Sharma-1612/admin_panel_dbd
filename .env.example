DATABASE_URL=postgres://user:password@localhost:5432/admin_panel

# S3-compatible storage (MinIO on Coolify). S3_ENDPOINT should be MinIO's
# internal network address (e.g. http://minio-<uuid>:9000 on Coolify) — it's
# never reached directly by browsers, only server-to-server.
S3_ENDPOINT=http://minio.internal:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=admin-panel-media

# S3_PUBLIC_URL_BASE points at this app's own /api/media route (see
# src/app/api/media/[...key]/route.ts), which proxies objects from S3/MinIO
# over this app's own domain. This means MinIO never needs its own public
# domain/HTTPS cert, and never has to be exposed to the internet at all.
S3_REGION=us-east-1
S3_PUBLIC_URL_BASE=https://admin.example.com/api/media

# Optional — used only by `npm run db:seed`. If omitted, a random one-time
# password is generated and printed to the console during seeding.
SEED_ADMIN_EMAIL=admin@designbydial.com
SEED_ADMIN_PASSWORD=
