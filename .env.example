DATABASE_URL=postgres://user:password@localhost:5432/admin_panel

# S3-compatible storage (MinIO on Coolify)
S3_ENDPOINT=https://minio.example.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=admin-panel-media
S3_REGION=us-east-1
S3_PUBLIC_URL_BASE=https://minio.example.com/admin-panel-media

# Optional — used only by `npm run db:seed`. If omitted, a random one-time
# password is generated and printed to the console during seeding.
SEED_ADMIN_EMAIL=admin@designbydial.com
SEED_ADMIN_PASSWORD=
